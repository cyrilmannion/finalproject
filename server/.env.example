PORT=4000
# Path to the local SQLite file, relative to the server/ folder. Defaults to data/stepaside.db if unset.
SQLITE_DB_PATH=./data/stepaside.db
JWT_SECRET=change-me-in-.env
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5173

# Not used yet - for the eventual AWS RDS (Postgres) deployment, once db/index.ts is swapped over.
# DATABASE_URL=postgres://user:password@localhost:5432/stepaside

# Optional - overrides the coordinates the weather widget fetches for (defaults to Enniskerry Road, Kilternan, Co. Dublin).
# WEATHER_LAT=53.2356
# WEATHER_LON=-6.1934
